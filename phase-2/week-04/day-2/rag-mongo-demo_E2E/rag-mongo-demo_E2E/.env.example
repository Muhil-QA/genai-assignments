# ======================== MongoDB Database & Collections ========================
# MongoDB Atlas Connection URI with credentials
MONGODB_URI="mongodb+srv://sankar:O5qO9PVyVifXY0Fq@india.lvn4ipa.mongodb.net/?appName=India"
# Database Name
DB_NAME="db_stories_tests"

# Test Cases Collection & Search Indexes
COLLECTION_NAME="test_cases"
VECTOR_INDEX_NAME="vector_index_test_cases"
BM25_INDEX_NAME="bm25_search"

# User Stories Collection & Search Indexes
USER_STORIES_COLLECTION_NAME="user_stories"
USER_STORIES_VECTOR_INDEX_NAME="vector_index_user_story"
USER_STORIES_BM25_INDEX_NAME="bm25_user_stories"

# ======================== Task-Specific LLM Models ========================
# 1. Primary Test Case Generation / QA LLM (groq | gemini | openai | claude | mistral | nvidia)
LLM_PROVIDER="nvidia"
LLM_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# 2. Semantic Reranking LLM (groq | gemini | openai | claude | mistral | nvidia)
RERANK_PROVIDER="nvidia"
RERANK_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# 3. Summarization & Deduplication LLM (groq | gemini | openai | claude | mistral | nvidia)
SUMMARIZATION_PROVIDER="nvidia"
SUMMARIZATION_MODEL="nvidia/nemotron-3.5-lightning-30b-a3b"

# ======================== Token Optimization & 8k Budget Control ========================
# Enable token budgeting to strictly stay under token limits
ENABLE_TOKEN_OPTIMIZATION="false"
MAX_TOTAL_TOKENS="32000"
MAX_GENERATION_TOKENS="4000"
MAX_SUMMARY_TOKENS="800"

# ======================== Automatic Fallback Mechanism ========================
# Enable automatic failover on rate limits (HTTP 429) or server outages
ENABLE_FALLBACK="true"
FALLBACK_LLM_PROVIDER="nvidia"
FALLBACK_LLM_MODEL="meta/llama-3.3-70b-instruct"
FALLBACK_LLM_PROVIDER_2="nvidia"
FALLBACK_LLM_MODEL_2="nvidia/nemotron-3-ultra-550b-a55b"

# ======================== Vector Embeddings Configuration ========================
# Supported Embedding Providers: mistral (1024 dims) | openai (1536 dims) | gemini (768 dims)
EMBEDDING_PROVIDER="mistral"
EMBEDDING_MODEL="mistral-embed"

# ======================== API Keys Vault ========================
GROQ_API_KEY="your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY="your_mistral_api_key"
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"


