    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\n\nconst mergedItem = {\n  json: {},\n  binary: {},\n};\n\nlet fileIndex = 1;\n\ninputItems.forEach((item) => {\n  if (item.binary) {\n    Object.keys(item.binary).forEach((key) => {\n      // Assign each binary file to a unique dynamic key (file1, file2, ..., file6)\n      mergedItem.binary[`file${fileIndex}`] = item.binary[key];\n      fileIndex++;\n    });\n  }\n});\n\nreturn [mergedItem];"
      },
